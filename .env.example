# ─────────────────────────────────────────────────────────────────────────
# 環境變數範例
#
# 使用方式：`cp .env.example .env`，再依需求修改。
#
# 命名規則：runtimeConfig 的鍵加上 `NUXT_` 前綴並轉成大寫底線。
#   sessionPassword       → NUXT_SESSION_PASSWORD
#   firebase.projectId    → NUXT_FIREBASE_PROJECT_ID
#   public.appName        → NUXT_PUBLIC_APP_NAME
#
# 標記 [必填] 的項目在 production 缺少時，服務會**直接拒絕啟動**
# （見 server/plugins/00.env-validate.ts）。這是刻意的：設定錯誤在部署時
# 就爆掉，好過上線後才發現網站跑在示範資料上、或登入用的是開發模式。
# ─────────────────────────────────────────────────────────────────────────

# ── Session ─────────────────────────────────────────────────────────────

# [必填] 加密 session cookie 的密鑰，**至少 32 個字元**。
# 每個環境都要用不同的值，且絕對不可提交進版本控制。
# 產生方式：openssl rand -base64 48
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-at-least-32-characters

# session 有效秒數（預設 8 小時）
NUXT_SESSION_MAX_AGE=28800

# ── Firebase ────────────────────────────────────────────────────────────
#
# 取得方式：Firebase Console → 專案設定 → 服務帳戶 → 產生新的私密金鑰，
# 下載的 JSON 裡有 project_id、client_email、private_key 三個值。
#
# 留空時：資料會使用記憶體中的示範內容（重啟即失），方便還沒開通 Firebase
# 就先看畫面。production 缺少這些值會直接無法啟動。

# [必填]
NUXT_FIREBASE_PROJECT_ID=
# [必填]
NUXT_FIREBASE_CLIENT_EMAIL=
# [必填] 私鑰是多行的，.env 無法直接換行 —— 請保留 JSON 裡的 \n 字面寫法，
# 整串用雙引號包起來，例如："-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# 註：**部署到 Firebase App Hosting 時不需要這兩項**。那裡跑在 Google Cloud 上，
# Admin SDK 會用執行環境本身的身分（ADC）存取 Firestore，只要設 PROJECT_ID 即可。
# 本機開發沒有 ADC，所以還是要填。
NUXT_FIREBASE_PRIVATE_KEY=
# Storage bucket 名稱，例如 my-team.firebasestorage.app。
# 留空則圖片上傳會改存記憶體（重啟即失），或改用貼外部網址。
NUXT_FIREBASE_STORAGE_BUCKET=
# [必填] Web API 金鑰：Firebase Console → 專案設定 → 一般 → 網頁 API 金鑰。
# 後台登入時由 BFF 在伺服器端用它呼叫 Identity Toolkit 驗證帳密。
# 留空時登入會退回開發模式（任何 email + password1234）。
NUXT_FIREBASE_WEB_API_KEY=

# ── Gemini（圖片辨識）───────────────────────────────────────────────────

# Google AI Studio（https://aistudio.google.com/apikey）產生的 API key。
# 留空時後台的「辨識賽程圖」與「辨識計分板」會回報無法使用，其餘功能不受影響。
NUXT_GEMINI_API_KEY=

# 使用的模型。換模型不需要改程式碼。
NUXT_GEMINI_MODEL=gemini-2.5-flash

# 單次辨識的逾時毫秒數。視覺推理比一般 API 慢，預設給 60 秒。
NUXT_GEMINI_TIMEOUT_MS=60000

# ── 中央氣象署（比賽當天的天氣預報）─────────────────────────────────────
#
# 申請授權碼：https://opendata.cwa.gov.tw/user/authkey（免費，要先註冊會員）
# 用的資料集是 F-D0047-091（一週預報，實際回傳 22 個縣市）。
#
# 留空時天氣功能整個關閉（後台的縣市欄位還在，只是前台不顯示），
# 網站其餘功能不受影響。
#
# ⚠️ 預報只有一週。賽程若排在更久以後，前台會明講「還沒有預報」——
# 這是資料來源的限制，不是設定問題。
NUXT_CWA_API_KEY=

# ── 推播（Web Push / VAPID）─────────────────────────────────────────────
#
# 三項都填才會啟用推播；缺任何一項，前台的訂閱按鈕與後台的推播頁面都會關閉，
# 網站其餘功能完全不受影響。
#
# 產生金鑰：npx web-push generate-vapid-keys
#
# ⚠️ 換掉私鑰等於讓所有既有訂閱失效，每個人都要重新開啟一次通知。

# 私鑰。絕對不可提交進版本控制。
NUXT_VAPID_PRIVATE_KEY=
# 聯絡方式。推送服務遇到問題時會用它找我們，格式是 mailto: 或 https 網址。
NUXT_VAPID_SUBJECT=mailto:team@example.com

# ── 外部呼叫與斷路器 ────────────────────────────────────────────────────

# 呼叫外部服務（Gemini、Identity Toolkit）的預設逾時毫秒數
NUXT_UPSTREAM_TIMEOUT_MS=10000

# 連續失敗幾次後跳閘，之後的請求會快速失敗而不打上游
NUXT_CIRCUIT_BREAKER_THRESHOLD=5

# 跳閘後多久放行一個請求試探上游是否恢復（毫秒）
NUXT_CIRCUIT_BREAKER_RESET_MS=30000

# ── 資安 ────────────────────────────────────────────────────────────────

# CORS 白名單，多個以逗號分隔。
# 留空 = 只允許同源（最安全，也是這個專案該用的設定）。
# 絕對不要填 *：本服務使用 cookie 認證，通配符等於允許任何網站代表使用者發請求。
NUXT_CORS_ORIGINS=

# 單一 IP 在時間窗內的最大請求數
NUXT_RATE_LIMIT_MAX=100

# 流量限制的時間窗（毫秒）
NUXT_RATE_LIMIT_WINDOW_MS=60000

# 一般請求 body 大小上限（bytes，預設 1MB）
NUXT_MAX_BODY_BYTES=1048576

# 圖片上傳與 AI 辨識路由的 body 上限（bytes，預設 8MB）。
# 圖片以 base64 傳輸會膨脹約 33%，設定時要把這點算進去。
NUXT_MAX_UPLOAD_BYTES=8388608

# ── 前端可見的設定（會被打包進瀏覽器，只能放非機密資訊）──────────────

# 網站名稱的後備值。實際顯示的隊名以後台「網站設定」為準。
NUXT_PUBLIC_APP_NAME=球隊官網
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_LOGIN_PATH=/admin/login

# VAPID 公鑰。這個值**本來就該公開** —— 瀏覽器訂閱推播時必須帶上它。
# 與上面的 NUXT_VAPID_PRIVATE_KEY 是同一次 generate-vapid-keys 產生的一對。
NUXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── 執行環境 ────────────────────────────────────────────────────────────

# 日誌等級：trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# 出現在每筆 log 的服務識別
SERVICE_NAME=baseball-official

# 伺服器埠號
PORT=3000

# 收到 SIGTERM 後，等待負載平衡器把流量移走的時間（毫秒）
SHUTDOWN_DRAIN_MS=10000

# ── 測試用開關 ──────────────────────────────────────────────────────────

# 允許 production 建置跑在記憶體示範資料與開發模式登入上。
# `pnpm test:e2e` 會自動設定它（e2e 跑的是 production 建置，但不該依賴真的 Firestore）。
# ⚠️ 正式部署絕對不要設定它 —— 開著等於網站跑在假資料上、後台用萬用密碼就能登入。
# ALLOW_MEMORY_STORE=true
